{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "outFile": "dist/report.js",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "removeComments": false,
    "sourceMap": false,
    "types": []
  },
  "files": [
    "src/types.ts",
    "src/format.ts",
    "src/charts.ts",
    "src/screens.ts",
    "src/main.ts"
  ]
}
