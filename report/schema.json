{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matkicail/glasshouse/report/schema.json",
  "title": "glasshouse report",
  "description": "Everything the report suite shows about several models on one dataset. Produced by glasshouse.report.build; read by report/src (TypeScript). Nothing is recomputed in the browser.",
  "type": "object",
  "required": [
    "schema",
    "task",
    "provenance",
    "models",
    "scorecards",
    "naive",
    "comparisons",
    "curves",
    "residuals"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "glasshouse-report/1"
    },
    "task": {
      "type": "object",
      "required": [
        "type",
        "family",
        "primary_metric",
        "n_bins"
      ],
      "properties": {
        "type": {
          "enum": [
            "frequency",
            "severity",
            "pure_premium",
            "binary",
            "regression"
          ]
        },
        "family": {
          "enum": [
            "gaussian",
            "poisson",
            "gamma",
            "tweedie",
            "binomial"
          ]
        },
        "power": {
          "type": [
            "number",
            "null"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "primary_metric": {
          "type": "string"
        },
        "n_bins": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "dataset",
        "describe",
        "n_rows",
        "weight_sum",
        "sample_rows",
        "sample_seed"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "describe": {
          "type": "string"
        },
        "split": {
          "type": [
            "object",
            "null"
          ]
        },
        "n_rows": {
          "type": "integer",
          "minimum": 1
        },
        "weight_sum": {
          "type": "number"
        },
        "sample_rows": {
          "type": "integer",
          "minimum": 0
        },
        "sample_seed": {
          "type": "integer"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scorecards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "family",
          "n_rows",
          "metrics",
          "naive",
          "calibration"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "n_rows": {
            "type": "integer"
          },
          "weight_sum": {
            "type": "number"
          },
          "naive_prediction": {
            "type": "number"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "naive": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "calibration": {
            "$ref": "#/$defs/binned"
          }
        }
      }
    },
    "naive": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "rows"
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "lorenz",
              "lift",
              "double_lift",
              "calibration",
              "roc",
              "pr"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "definition",
          "summary",
          "histogram",
          "scatter",
          "by_feature",
          "by_pair"
        ],
        "properties": {
          "definition": {
            "type": "object"
          },
          "summary": {
            "type": "object",
            "required": [
              "deviance",
              "pearson"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/stats"
            }
          },
          "histogram": {
            "type": "object",
            "required": [
              "edges",
              "counts"
            ],
            "properties": {
              "edges": {
                "$ref": "#/$defs/numbers"
              },
              "counts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "scatter": {
            "type": "object",
            "required": [
              "fitted",
              "deviance",
              "actual"
            ],
            "properties": {
              "fitted": {
                "$ref": "#/$defs/numbers"
              },
              "deviance": {
                "$ref": "#/$defs/numbers"
              },
              "actual": {
                "$ref": "#/$defs/numbers"
              }
            }
          },
          "by_feature": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ae_by_feature"
            }
          },
          "by_pair": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ae_by_two"
            },
            "description": "A/E on the grid of every pair of features: the interaction view. Cells under weight_floor are thin."
          },
          "over_time": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/ae_by_feature"
              }
            ]
          }
        }
      }
    },
    "bench": {
      "type": "object",
      "description": "Present when the document was produced by `glasshouse bench`: per-fold scorecards and timings.",
      "required": [
        "summary",
        "folds"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "mean",
                "std"
              ],
              "properties": {
                "mean": {
                  "type": "number"
                },
                "std": {
                  "type": "number"
                }
              }
            }
          }
        },
        "naive_summary": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "mean",
              "std"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number"
              }
            }
          }
        },
        "folds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "fold",
              "seconds"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "fold": {
                "type": "integer"
              },
              "seconds": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "tournament": {
      "type": "object",
      "description": "Priced tasks only (not binary): every row goes to the cheapest model, ties split equally; per model the weight won, what it charged there, what it cost. pairs: one table per model pair; overall: all models at once.",
      "required": [
        "pairs",
        "overall"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "labels",
              "share",
              "weight",
              "predicted",
              "actual",
              "profit",
              "actual_over_expected"
            ],
            "properties": {
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "share": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "weight": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "predicted": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "actual": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "profit": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "actual_over_expected": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "overall": {
          "type": "object",
          "required": [
            "labels",
            "share",
            "weight",
            "predicted",
            "actual",
            "profit",
            "actual_over_expected"
          ],
          "properties": {
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "share": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "weight": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "predicted": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "actual": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "profit": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "actual_over_expected": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "description": "Binary tasks only: every decision metric precomputed at evenly spaced thresholds; the viewer's slider walks this grid.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "threshold",
          "tp",
          "fp",
          "fn",
          "tn",
          "precision",
          "recall",
          "f1",
          "mcc",
          "alerts",
          "alerts_per_tp"
        ],
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "explain": {
      "type": "object",
      "description": "Per model (bench only): partial dependence and permutation importance on held-out rows, mean and spread across folds; coefficients for glass-box models.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "partial_dependence",
          "importance",
          "coefficients"
        ],
        "properties": {
          "partial_dependence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature",
                "kind",
                "grid",
                "mean",
                "low",
                "high"
              ],
              "properties": {
                "feature": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "numeric",
                    "categorical"
                  ]
                },
                "grid": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                },
                "mean": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "low": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "high": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "importance": {
            "type": "object",
            "required": [
              "features",
              "mean",
              "std",
              "base_deviance"
            ],
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mean": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "std": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "base_deviance": {
                "type": "number"
              }
            }
          },
          "coefficients": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "terms",
              "mean",
              "std",
              "relativity"
            ],
            "properties": {
              "terms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mean": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "std": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "relativity": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "description": "The data before any model: even-width histograms of the outcome and the weight, and each feature's weight and mean outcome per bin or level.",
      "required": [
        "target",
        "weight",
        "features"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/histogram"
        },
        "weight": {
          "oneOf": [
            {
              "$ref": "#/$defs/histogram"
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature_profile"
          }
        }
      }
    }
  },
  "$defs": {
    "numbers": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "mean",
        "std",
        "median"
      ],
      "additionalProperties": {
        "type": "number"
      }
    },
    "binned": {
      "type": "object",
      "required": [
        "n_rows",
        "weight",
        "predicted",
        "actual",
        "actual_over_expected"
      ],
      "properties": {
        "n_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weight": {
          "$ref": "#/$defs/numbers"
        },
        "predicted": {
          "$ref": "#/$defs/numbers"
        },
        "actual": {
          "$ref": "#/$defs/numbers"
        },
        "actual_over_expected": {
          "$ref": "#/$defs/numbers"
        }
      }
    },
    "ae_by_feature": {
      "type": "object",
      "required": [
        "kind",
        "feature",
        "label",
        "level",
        "n_rows",
        "weight",
        "predicted",
        "actual",
        "actual_over_expected"
      ],
      "properties": {
        "kind": {
          "const": "ae_by_feature"
        },
        "feature": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weight": {
          "$ref": "#/$defs/numbers"
        },
        "predicted": {
          "$ref": "#/$defs/numbers"
        },
        "actual": {
          "$ref": "#/$defs/numbers"
        },
        "actual_over_expected": {
          "$ref": "#/$defs/numbers"
        }
      }
    },
    "histogram": {
      "type": "object",
      "required": [
        "name",
        "level",
        "edges",
        "n_rows",
        "weight",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "level": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "$ref": "#/$defs/numbers"
        },
        "n_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weight": {
          "$ref": "#/$defs/numbers"
        },
        "summary": {
          "type": "object",
          "required": [
            "mean",
            "std",
            "min",
            "q05",
            "q25",
            "median",
            "q75",
            "q95",
            "max",
            "zero_share"
          ],
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "feature_profile": {
      "type": "object",
      "required": [
        "feature",
        "kind",
        "level",
        "edges",
        "n_rows",
        "weight",
        "actual",
        "n_levels"
      ],
      "properties": {
        "feature": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "numeric",
            "categorical"
          ]
        },
        "level": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "oneOf": [
            {
              "$ref": "#/$defs/numbers"
            },
            {
              "type": "null"
            }
          ]
        },
        "n_rows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weight": {
          "$ref": "#/$defs/numbers"
        },
        "actual": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "n_levels": {
          "type": "integer"
        }
      }
    },
    "ae_by_two": {
      "type": "object",
      "required": [
        "kind",
        "feature_a",
        "feature_b",
        "label",
        "level_a",
        "level_b",
        "n_rows",
        "weight",
        "predicted",
        "actual",
        "actual_over_expected",
        "weight_floor"
      ],
      "properties": {
        "kind": {
          "const": "ae_by_two"
        },
        "feature_a": {
          "type": "string"
        },
        "feature_b": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level_a": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level_b": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n_rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "weight": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "predicted": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "actual": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "actual_over_expected": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "weight_floor": {
          "type": "number"
        }
      }
    }
  }
}
