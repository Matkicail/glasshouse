# --- docs policy: every .md is internal unless whitelisted below ---
*.md
!README.md
!CLAUDE.md
!COMMANDS.md
!CHANGELOG.md
!docs/**/*.md
# plan2-*.md and session*-addendum.md are covered by *.md above: never tracked.

# --- secrets / local ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- rust ---
target/
Cargo.lock.bak

# --- data / benchmarks (raw data never committed; small fixtures and reports are) ---
data/
*.parquet
*.feather
*.arrow
*.ipc
*.csv
*.tsv
*.json
*.jsonl
*.xlsx
*.xls
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.arff
*.zip
*.gz
*.gzip
*.zst
*.zstd
*.bz2
*.xz
*.7z
*.tar
!tests/fixtures/**
!benchmarks/**/*.json
!benchmarks/**/*.csv

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- build artifacts (the extension is built by uv sync / maturin, never committed) ---
*.so
*.pyd
*.dylib

# --- personal scratch: benchmarks, proofs, experiments. Never tracked. ---
scratch/
